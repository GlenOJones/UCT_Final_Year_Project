@article{jordtRefractive3DReconstruction2016,
  title = {Refractive {{3D}} Reconstruction on Underwater Images},
  author = {Jordt, Anne and K{\"o}ser, Kevin and Koch, Reinhard},
  year = 2016,
  month = apr,
  journal = {Methods in Oceanography},
  series = {Computer {{Vision}} in {{Oceanography}}},
  volume = {15--16},
  pages = {90--113},
  issn = {2211-1220},
  doi = {10.1016/j.mio.2016.03.001},
  urldate = {2026-07-29},
  abstract = {Cameras can be considered measurement devices complementary to acoustic sensors when it comes to surveying marine environments. When calibrated and used correctly, these visual sensors are well-suited for automated detection, quantification, mapping, and monitoring applications and when aiming at high-accuracy 3D models or change detection. In underwater scenarios, cameras are often set up in pressure housings with a flat glass window, a flat port, which allows them to observe the environment. In this contribution, a geometric model for image formation is discussed that explicitly considers refraction at the interface under realistic assumptions like a slightly misaligned camera (w.r.t. the glass normal) and thick glass ports as common for deep sea applications. Then, starting from camera calibration, a complete, fully automated 3D reconstruction system is discussed that takes an image sequence and produces a 3D model. Newly derived refractive estimators for sparse two-view geometry, pose estimation, bundle adjustment, and dense depth estimation are discussed and evaluated in detail.},
  keywords = {3D model,Flat port,Plane sweep,Refraction,Structure-from-Motion,Underwater reconstruction},
  file = {/home/glen/Zotero/storage/6HVFNWVG/Jordt et al. - 2016 - Refractive 3D reconstruction on underwater images.pdf;/home/glen/Zotero/storage/REY7YNJB/S2211122015300086.html}
}

