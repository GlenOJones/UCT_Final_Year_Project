@article{lavestDryCameraCalibration2003,
  title = {Dry Camera Calibration for Underwater Applications},
  author = {Lavest, J.M. and Rives, G. and Laprest{\'e}, J.T.},
  year = 2003,
  month = mar,
  journal = {Machine Vision and Applications},
  volume = {13},
  number = {5},
  pages = {245--253},
  issn = {1432-1769},
  doi = {10.1007/s00138-002-0112-z},
  urldate = {2026-08-10},
  abstract = {Is it possible to calibrate a camera in the air and then use the calibration results to infer a new calibration corresponding to the embedding of the camera in another fluid (possibly water)? This problem is dealt within the paper. It is important to avoid direct underwater calibration, as it is much more inconvenient for experiments than the usual (air) calibration by human workers. Optical laws that must be considered when using underwater cameras are investigated. Both theoretical and experimental point of views are described, and it is shown that relationships can be found between results of air and water (or any other isotropic fluid in which the camera can be submerged) calibration.},
  langid = {english},
  keywords = {Key words: Camera calibration - Underwater camera - Thick-lens model - Distortion},
  file = {/home/glen/Zotero/storage/E7BRNLTF/Lavest et al. - 2003 - Dry camera calibration for underwater applications.pdf}
}

