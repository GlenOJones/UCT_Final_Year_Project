@article{williamsThickDeformedAntarctic2015a,
  title = {Thick and Deformed {{Antarctic}} Sea Ice Mapped with Autonomous Underwater Vehicles},
  author = {Williams, G. and Maksym, T. and Wilkinson, J. and Kunz, C. and Murphy, C. and Kimball, P. and Singh, H.},
