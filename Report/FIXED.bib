@article{zygmuntowskaUncertaintiesArcticSea2014,
  title = {Uncertainties in {{Arctic}} Sea Ice Thickness and Volume: New Estimates and Implications for Trends},
  shorttitle = {Uncertainties in {{Arctic}} Sea Ice Thickness and Volume},
  author = {Zygmuntowska, M. and Rampal, P. and Ivanova, N. and Smedsrud, L. H.},
  year = 2014,
  month = apr,
  journal = {The Cryosphere},
  volume = {8},
  number = {2},
  pages = {705--720},
  issn = {1994-0424},
  doi = {10.5194/tc-8-705-2014},
  urldate = {2026-10-24},
  abstract = {Abstract. Sea ice volume has decreased in the last decades, evoked by changes in sea ice area and thickness. Estimates of sea ice area and thickness rely on a number of geophysical parameters which introduce large uncertainties. To quantify these uncertainties we use freeboard retrievals from ICESat and investigate different assumptions about snow depth, sea ice density and area. We find that uncertainties in ice area are of minor importance for the estimates of sea ice volume during the cold season in the Arctic basin. The choice of mean ice density used when converting sea ice freeboard into thickness mainly influences the resulting mean sea ice thickness, while snow depth on top of the ice is the main driver for the year-to-year variability, particularly in late winter. The absolute uncertainty in the mean sea ice thickness is 0.28 m in February/March and 0.21 m in October/November. The uncertainty in snow depth contributes up to 70\% of the total uncertainty and the ice density 30--35\%, with higher values in October/November. We find large uncertainties in the total sea ice volume and trend. The mean total sea ice volume is 10 120 \textpm{} 1280 km3 in October/November and 13 250 \textpm{} 1860 km3 in February/March for the time period 2005--2007. Based on these uncertainties we obtain trends in sea ice volume of -1450 \textpm{} 530 km3 a-1 in October/November and -880 \textpm{} 260 km3 a-1 in February/March over the ICESat period (2003--2008). Our results indicate that, taking into account the uncertainties, the decline in sea ice volume in the Arctic between the ICESat (2003--2008) and CryoSat-2 (2010--2012) periods may have been less dramatic than reported in previous studies. However, more work and validation is required to quantify these changes and analyse possible unresolved biases in the freeboard retrievals.},
  copyright = {https://creativecommons.org/licenses/by/3.0/},
  langid = {english},
  file = {/home/glen/Zotero/storage/79EXH5AJ/Zygmuntowska et al. - 2014 - Uncertainties in Arctic sea ice thickness and volume new estimates and implications for trends.pdf}
}
