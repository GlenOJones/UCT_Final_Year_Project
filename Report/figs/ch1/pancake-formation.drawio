<mxfile><diagram id="pancake" name="Pancake-ice formation"><mxGraphModel adaptiveColors="auto" grid="1" gridSize="10"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="(i) Frazil layer forms by vertical accumulation and rafting of small frazil discs" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=bottom;fontFamily=Helvetica;fontSize=14;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="640" height="50" as="geometry"/></mxCell><mxCell id="p1" value="" style="shape=stencil();strokeColor=#333333;fillColor=#333333;" vertex="1" parent="1"><mxGeometry x="0" y="50" width="640" height="130" as="geometry"/></mxCell><mxCell id="t2" value="(ii) Freezing forms small primary pancakes" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=bottom;fontFamily=Helvetica;fontSize=14;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="0" y="200" width="640" height="50" as="geometry"/></mxCell><mxCell id="p2" value="" style="shape=stencil();strokeColor=#333333;fillColor=#333333;" vertex="1" parent="1"><mxGeometry x="0" y="250" width="640" height="130" as="geometry"/></mxCell><mxCell id="t3" value="(iii) High-frequency waves damped, primary pancakes raft under the longer waves, frazil production reduced" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=bottom;fontFamily=Helvetica;fontSize=14;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="0" y="400" width="640" height="50" as="geometry"/></mxCell><mxCell id="p3" value="" style="shape=stencil();strokeColor=#333333;fillColor=#333333;" vertex="1" parent="1"><mxGeometry x="0" y="450" width="640" height="130" as="geometry"/></mxCell><mxCell id="t4" value="(iv) Freezing of primary pancakes forms mature pancakes, frazil production further reduces" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=bottom;fontFamily=Helvetica;fontSize=14;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="0" y="600" width="640" height="50" as="geometry"/></mxCell><mxCell id="p4" value="" style="shape=stencil();strokeColor=#333333;fillColor=#333333;" vertex="1" parent="1"><mxGeometry x="0" y="650" width="640" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>