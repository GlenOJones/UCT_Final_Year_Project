<mxfile><diagram id="pancakecyclelr" name="Pancake cycle (left to right)"><mxGraphModel adaptiveColors="auto" grid="1" gridSize="10"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="1. New ice formation:&lt;br&gt;frazil ice" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=34;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="460" height="80" as="geometry"/></mxCell><mxCell id="b1" value="" style="shape=stencil();strokeColor=#333333;fillColor=#333333;" vertex="1" parent="1"><mxGeometry x="0" y="80" width="460" height="200" as="geometry"/></mxCell><mxCell id="t2" value="2. Formation of&lt;br&gt;pancake ice" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=34;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="510" y="0" width="460" height="80" as="geometry"/></mxCell><mxCell id="b2" value="" style="shape=stencil();strokeColor=#333333;fillColor=#333333;" vertex="1" parent="1"><mxGeometry x="510" y="80" width="460" height="200" as="geometry"/></mxCell><mxCell id="t3" value="3. Freezing together and&lt;br&gt;rafting of pancake ice" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=34;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1020" y="0" width="460" height="80" as="geometry"/></mxCell><mxCell id="b3" value="" style="shape=stencil();strokeColor=#333333;fillColor=#333333;" vertex="1" parent="1"><mxGeometry x="1020" y="80" width="460" height="200" as="geometry"/></mxCell><mxCell id="t4" value="4. Further rafting and&lt;br&gt;new ice formation" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=34;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1530" y="0" width="460" height="80" as="geometry"/></mxCell><mxCell id="b4" value="" style="shape=stencil();strokeColor=#333333;fillColor=#333333;" vertex="1" parent="