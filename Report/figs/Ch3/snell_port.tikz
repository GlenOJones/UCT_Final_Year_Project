% Refraction at a flat port (Snell's law). Geometry computed for n_a=1, n_g=1.5, n_w=1.333, theta_a=35 deg.
% Needs \usetikzlibrary{arrows.meta,calc} (already loaded in 0_main.tex).
\begin{tikzpicture}[scale=1.3,font=\small,>={Stealth[length=2mm]}]
	% port and media
	\fill[black!8] (1.25,0.55) rectangle (2.05,-2.472);
	\draw (1.25,0.55) -- (1.25,-2.472) (2.05,0.55) -- (2.05,-2.472);
	\node at (0.825,0.35000000000000003) {air, $n_a$};
	\node[above] at (1.65,0.55) {glass, $n_g$};
	\node at (3.3249999999999997,0.35000000000000003) {water, $n_w$};
	\draw[dashed,black!55] (-0.781,0) -- (4.6499999999999995,0) node[right,black] {port normal};
	% angle wedges
	\fill[black!14] (1.250,-0.875) -- ++(180.00:0.75) arc (180.00:145.00:0.75) -- cycle;
	\fill[black!14] (1.250,-0.875) -- ++(0.00:0.55) arc (0.00:-22.48:0.55) -- cycle;
	\fill[black!14] (2.050,-1.206) -- ++(0.00:0.95) arc (0.00:-25.49:0.95) -- cycle;
	% local normals
	\draw[densely dashed,black!55] (0.4,-0.875) -- (2.05,-0.875);
	\draw[densely dashed,black!55] (2.050,-1.206) -- (3.150,-1.206);
	% water ray traced back to the axis
	\draw[black!55,dashed,thick] (2.050,-1.206) -- (-0.481,0);
	% the refracted ray, water -> glass -> air -> O
	\draw[thick] (4.600,-2.422) -- (2.050,-1.206);
	\draw[thick,->] (4.600,-2.422) -- ($ (4.600,-2.422)!0.55!(2.050,-1.206) $);
	\draw[thick] (2.050,-1.206) -- (1.250,-0.875);
	\draw[thick] (1.250,-0.875) -- (0.000,0.000);
	\draw[thick,->] (1.250,-0.875) -- ($ (1.250,-0.875)!0.55!(0.000,0.000) $);
	\fill (0,0) circle (1.3pt);
	\node at (0.2,0.17) {$O$};
	\draw[black!70,fill=white] (-0.481,0) circle (1.3pt);
	% angle arcs and labels
	\draw (1.250,-0.875) ++(180:0.75) arc (180:145.00:0.75);
	\node at ($ (1.250,-0.875)+(162.50:1.0) $) {$\theta_a$};
	\draw (1.250,-0.875) ++(0:0.55) arc (0:-22.48:0.55);
	\node at ($ (1.250,-0.875)+(-10.24:0.68) $) {\footnotesize$\theta_g$};
	\draw (2.050,-1.206) ++(0:0.95) arc (0:-25.49:0.95);
	\node at ($ (2.050,-1.206)+(-12.74:1.2) $) {$\theta_w$};
	% dimensions
	\draw[black!60] (0,-0.12) -- (0,-2.742);
	\draw[<->,black!70] (0,-2.622) -- (1.25,-2.622) node[midway,below=-1pt] {$d_0$};
	\draw[<->,black!70] (1.25,-2.622) -- (2.05,-2.622) node[midway,below=-1pt] {$d_1$};
	\draw[black!60] (0,0.1) -- (0,0.5) (-0.481,0.1) -- (-0.481,0.5);
	\draw[<->,black!70] (-0.481,0.4) -- (0,0.4) node[midway,above=-1pt] {$\Delta x$};
\end{tikzpicture}
