# =====================================================================
#   latexmk configuration
# =====================================================================
#   XeLaTeX. Text is the real Times New Roman (fontspec), maths is newtxmath.
#
#       latexmk 0_main
#
#   Overleaf reads this file too, so the word count works there as well.
# =====================================================================
# Engine: XeLaTeX, ALWAYS. pdf_mode 5 = XeLaTeX -> .xdv -> xdvipdfmx.
#
# The thesis used to fail to build at random. The cause was two engines
# taking turns: VS Code's default LaTeX Workshop recipe is "latexmk -pdf",
# which forces pdfLaTeX whenever the workspace is opened at 4022/ instead of
# Report/ (Report/.vscode is then not read), while this file asked for
# XeLaTeX. Each engine then tripped over the other's leftover .aux/.out files.
#
# So $pdflatex below ALSO runs xelatex: whatever flag latexmk is given
# (-pdf, -xelatex or none) the same engine builds the thesis. To really go
# back to pdfLaTeX, set $pdf_mode = 1 and restore the pdflatex sub below.
$pdf_mode = 5;

# ---------------------------------------------------------------------
#   Run the engine TWICE per latexmk pass.
# ---------------------------------------------------------------------
#   The page count on the declaration is computed as
#
#       \getpagerefnumber{body:end} - \getpagerefnumber{body:start} + 1
#
#   On the first pass those labels do not exist yet and refcount returns 0
#   for each, so the declaration prints "1 pages", which is 0 - 0 + 1. It is
#   wrong, and it is plausible enough to go unnoticed.
#
#   latexmk's rerun heuristics do not reliably catch this: the value changes
#   without LaTeX raising a warning it recognises. Rather than depend on
#   that, run the engine twice every time. It costs a few seconds and it
#   cannot be got wrong.
#
#   Done as a perl sub, not 'xelatex %O %S ; xelatex %O %S': latexmk
#   only fills in the FIRST %O, so the second run lost -interaction=nonstopmode
#   and sat waiting for keyboard input on any error, hanging the build.
#
#   $pdflatex points at the same sub on purpose (see the engine note at the
#   top). Called that way xelatex writes the PDF directly, which is what
#   latexmk expects in -pdf mode.
# ---------------------------------------------------------------------
$pdflatex = 'internal xelatex_twice %O %S';
$xelatex = 'internal xelatex_twice %O %S';
sub xelatex_twice {
    system('xelatex', @_);
    return system('xelatex', @_);
}
$clean_ext = 'synctex.gz run.xml bbl fdb_latexmk fls glo gls glg ist acn acr alg thesis-wordcount.tex';

# ---------------------------------------------------------------------
#   Glossary. makeglossaries has to run between LaTeX passes, or every
#   \gls{} comes out as ??.
# ---------------------------------------------------------------------
add_cus_dep('glo', 'gls', 0, 'makeglo2gls');
sub makeglo2gls {
    system("makeglossaries '$_[0]'");
}

# =====================================================================
#   AUTOMATIC WORD COUNT
# =====================================================================
#   The declaration page states a word count EXCLUDING the preamble, the
#   appendices and the bibliography. LaTeX cannot count words itself, so the
#   count is produced here and written to thesis-wordcount.tex, which 0_main.tex
#   reads back with \InputIfFileExists.
#
#   Only the files in @BODY are counted. ADD A CHAPTER HERE WHEN YOU ADD ONE
#   TO 0_main.tex, or it will not be counted.
#
#   texcount is used when available: it understands LaTeX, so it does not
#   count \section or the contents of an equation as words. It ships with TeX
#   Live and is present on Overleaf.
#
#   If texcount is missing, the fallback does a crude count in pure perl:
#   strip comments, maths and macros, then count what is left. It is
#   approximate, but it beats a number typed in by hand two months ago.
# =====================================================================
my @BODY = qw(
    1_intro.tex
    2_review.tex
    3_ch3.tex
    4_ch4.tex
    5_ch5.tex
    5b_reconstruction.tex
    6_results.tex
    7_discussion.tex
    8_conclusions.tex
    9_furtherwork.tex
);

sub count_words {
    my @files = grep { -e $_ } @BODY;
    return 0 unless @files;

    # preferred: texcount
    my $out = `texcount -1 -sum -q -merge @files 2>/dev/null`;
    if ($? == 0 && $out =~ /(\d+)/) {
        return $1;
    }

    # fallback: crude perl count
    my $words = 0;
    for my $f (@files) {
        open(my $fh, '<', $f) or next;
        local $/;
        my $t = <$fh>;
        close $fh;

        $t =~ s/(?<!\\)%.*$//mg;
        $t =~ s/\$\$.*?\$\$//gs;
        $t =~ s/\$[^\$]*\$//gs;
        $t =~ s/\\\[.*?\\\]//gs;
        $t =~ s/\\begin\{(equation|align|figure|table|tikzpicture|lstlisting)\*?\}.*?\\end\{\1\*?\}//gs;
        $t =~ s/\\[a-zA-Z\@]+\s*(\[[^\]]*\])?//g;
        $t =~ s/[{}\[\]&~\\]/ /g;
        $words += scalar(() = $t =~ /\b[\w'-]+\b/g);
    }
    return $words;
}

#   Runs only on a Full build: the Ctrl+S "Fast preview" is a plain xelatex
#   pass that never reads this file. The file is only rewritten when the
#   count changes; touching it every time made latexmk treat it as a changed
#   input and rerun.
sub write_wordcount {
    my $n = count_words();
    my $body = "% GENERATED FILE. Do not edit it, and do not commit it.\n"
             . "% Written by latexmkrc on a Full build. See .gitignore.\n"
             . "\\renewcommand{\\wordcount}{$n}\n";
    if (open(my $in, '<', 'thesis-wordcount.tex')) {
        local $/;
        my $old = <$in>;
        close $in;
        if (defined $old && $old eq $body) {
            print "latexmkrc: word count = $n (unchanged)\n";
            return;
        }
    }
    open(my $fh, '>', 'thesis-wordcount.tex') or return;
    print $fh $body;
    close $fh;
    print "latexmkrc: word count = $n\n";
}

write_wordcount();
