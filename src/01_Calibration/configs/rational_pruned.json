{
  "_comment": "Same detection as baseline, but the 8-coefficient rational distortion model plus outlier rejection at 3 px in both the mono and stereo steps. Exercises the variable-length distortion path and both rejection passes.",

  "name": "rational_pruned",

  "detection": {
    "min_tags_per_image": 10,
    "aruco_parameters": {
      "markerBorderBits": 2,
      "errorCorrectionRate": 1.0,
      "adaptiveThreshWinSizeMin": 3,
      "adaptiveThreshWinSizeMax": 53,
      "adaptiveThreshWinSizeStep": 5,
      "minOtsuStdDev": 2.0
    }
  },

  "corner_refinement": { "window_half_size": 5, "max_iter": 100, "epsilon": 0.001 },

  "calibration": {
    "distortion_model": "rational",
    "fix_k3": false,
    "zero_tangent_dist": false,
    "fix_aspect_ratio": false,
    "fix_principal_point": false,
    "max_iter": 30,
    "epsilon": 1e-6
  },

  "outlier_rejection": { "enabled": true, "max_image_error_px": 3.0 },

  "stereo": {
    "min_common_tags": 10,
    "refine_intrinsics": false,
    "max_iter": 100,
    "epsilon": 1e-6,
    "outlier_rejection": { "enabled": true, "max_pair_error_px": 3.0 },
    "rectify_alpha": 0,
    "expected_baseline_mm": null
  }
}
