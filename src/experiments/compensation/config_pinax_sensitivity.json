{
  "_comment": "Sensitivity of the Pinax result to its two inputs that are not measured here: the refractive index of the water (fresh 1.333, sea about 1.339) and which in-air calibration is used (detector preset). Brown-Conrady is included as the paired reference. Settings for run_comparison.py. Paths are relative to the project root. Distances are camera to board centre (mm); radii are normalised so the image corner farthest from the principal point is 1.",
  "pipeline_runs": {
    "_why": "The Calibration.py runs this comparison reads, made by reproduce.py before it runs. Every pipeline setting is stated. They use the gray channel, as the runs these results were first made from did; the standard pipeline's channel is merge.",
    "calibration": {"detector": "aruco", "reject": true, "min_tags": 10, "min_common_tags": 10, "detection_images": false},
    "runs": [
      {"medium": "Water", "frames": "data/Calibration/FinalComparison/Water", "preset": "water_final", "channel": "gray"},
      {"medium": "Air", "frames": "data/Calibration/FinalComparison/Air", "preset": "water_final", "channel": "gray"},
      {"medium": "Air", "frames": "data/Calibration/FinalComparison/Air", "preset": "wide", "channel": "gray"}
    ],
    "out_dir": "results/experiments/compensation/calibration"
  },
  "calibration": "results/experiments/compensation/calibration/Water/Water_water_final_stereo.yaml",
  "output": "results/experiments/compensation/water_final_pinax_sensitivity",
  "held_out_recordings": 2,
  "techniques": [
    {
      "key": "bc",
      "label": "Brown-Conrady",
      "model": "brown_conrady"
    },
    {
      "key": "pinax_water_final_n1.333",
      "label": "Pinax, air water_final, n=1.333",
      "model": "pinax",
      "options": {
        "air_calibration": "results/experiments/compensation/calibration/Air/Air_water_final_stereo.yaml",
        "n_water": 1.333
      }
    },
    {
      "key": "pinax_water_final_n1.339",
      "label": "Pinax, air water_final, n=1.339",
      "model": "pinax",
      "options": {
        "air_calibration": "results/experiments/compensation/calibration/Air/Air_water_final_stereo.yaml",
        "n_water": 1.339
      }
    },
    {
      "key": "pinax_wide_n1.333",
      "label": "Pinax, air wide, n=1.333",
      "model": "pinax",
      "options": {
        "air_calibration": "results/experiments/compensation/calibration/Air/Air_wide_stereo.yaml",
        "n_water": 1.333
      }
    }
  ],
  "distance_bands_mm": {
    "near": [
      200,
      800
    ],
    "far": [
      1000,
      1500
    ]
  },
  "zone_radii": [
    0.33,
    0.66
  ],
  "grid_cells": [
    8,
    6
  ],
  "min_points_per_cell": 5,
  "radial_bin_width": 0.05,
  "distance_bin_width_mm": 100,
  "min_points_per_bin": 50,
  "scale_bar_length_mm": [
    250,
    450
  ]
}