{
  "_comment": "Close-range check for Kannala-Brandt (missing from config_full.json): Brown-Conrady and Kannala-Brandt, each trained on all distances and on boards at 200-800 mm only, on the same calibration run and splits. Run: src/venv/bin/python src/experiments/compensation/run_comparison.py --config src/experiments/compensation/config_kb_close.json",
  "pipeline_runs": {
    "_why": "The Calibration.py runs this comparison reads, made by reproduce.py before it runs. Every pipeline setting is stated. They use the gray channel, as the runs these results were first made from did; the standard pipeline's channel is merge.",
    "calibration": {
      "detector": "aruco",
      "reject": true,
      "min_tags": 10,
      "min_common_tags": 10,
      "detection_images": false
    },
    "runs": [
      {
        "medium": "Water",
        "frames": "data/Calibration/FinalComparison/Water",
        "preset": "water_final",
        "channel": "gray"
      },
      {
        "medium": "Air",
        "frames": "data/Calibration/FinalComparison/Air",
        "preset": "water_final",
        "channel": "gray"
      }
    ],
    "out_dir": "results/experiments/compensation/calibration"
  },
  "calibration": "results/experiments/compensation/calibration/Water/Water_water_final_stereo.yaml",
  "output": "results/experiments/compensation/kb_close",
  "held_out_recordings": 2,
  "techniques": [
    {
      "key": "bc",
      "label": "T3 Brown-Conrady",
      "model": "brown_conrady"
    },
    {
      "key": "kb",
      "label": "T4 Kannala-Brandt",
      "model": "kannala_brandt"
    },
    {
      "key": "bc_close",
      "label": "Brown-Conrady, close-range training",
      "model": "brown_conrady",
      "train_distance_mm": [
        200,
        800
      ]
    },
    {
      "key": "kb_close",
      "label": "Kannala-Brandt, close-range training",
      "model": "kannala_brandt",
      "train_distance_mm": [
        200,
        800
      ]
    }
  ],
  "distance_bands_mm": {
    "near": [
      200,
      800
    ],
    "far": [
      1000,
      1500
    ]
  },
  "zone_radii": [
    0.33,
    0.66
  ],
  "grid_cells": [
    8,
    6
  ],
  "min_points_per_cell": 5,
  "radial_bin_width": 0.05,
  "distance_bin_width_mm": 100,
  "min_points_per_bin": 50,
  "scale_bar_length_mm": [
    250,
    450
  ],
  "report_cameras": [
    "left"
  ]
}